# Codex CLI is the default and needs no API key. Run `codex login` first.
# Wingdiff reads the optional settings below only in the local Node process.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Codex CLI overrides
# WINGDIFF_CODEX_BIN=codex
# WINGDIFF_CODEX_TIMEOUT_MS=180000

# Optional local binding overrides
# WINGDIFF_HOST=127.0.0.1
# WINGDIFF_PORT=4173
