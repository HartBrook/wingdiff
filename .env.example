# Codex CLI is the default and needs no API key. Run `codex login` first.
# Wingdiff reads the optional settings below only in the local Node process.
# Installed copies also read these settings from the platform config path shown
# by `wingdiff doctor`. Shell environment variables take precedence.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Codex CLI overrides
# WINGDIFF_CODEX_BIN=codex
# WINGDIFF_CODEX_TOUR_TIMEOUT_MS=600000
# WINGDIFF_CODEX_INVESTIGATION_TIMEOUT_MS=180000
# WINGDIFF_CODEX_TIMEOUT_MS=600000 # legacy override for both request types

# Optional local binding overrides
# WINGDIFF_HOST=127.0.0.1
# WINGDIFF_PORT=4173

# Optional persistent-data location. Wingdiff appends wingdiff.sqlite3.
# WINGDIFF_DATA_DIR=/path/to/private/data

# DANGEROUS: remote binding exposes source and review data to the network.
# Leave unset unless you have independently secured the server and understand
# that Wingdiff is designed and tested for loopback-only use.
# WINGDIFF_UNSAFE_ALLOW_REMOTE=1
