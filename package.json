{
  "name": "wingdiff",
  "version": "0.2.3",
  "description": "Understand a pull or merge request before you approve it. A local, open source guided review tour where every claim links to the diff.",
  "keywords": [
    "code-review",
    "pull-request",
    "github",
    "gitlab",
    "review",
    "ai",
    "local-first",
    "cli"
  ],
  "license": "MIT",
  "bin": {
    "wingdiff": "apps/server/dist/cli.js"
  },
  "files": [
    "apps/server/dist",
    "apps/web/dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HartBrook/wingdiff.git"
  },
  "bugs": {
    "url": "https://github.com/HartBrook/wingdiff/issues"
  },
  "homepage": "https://github.com/HartBrook/wingdiff#readme",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wingdiff/server",
    "wingdiff": "cross-env NODE_ENV=development tsx apps/server/src/cli.ts",
    "start": "npm run start --workspace @wingdiff/server",
    "build": "npm run build --workspace @wingdiff/web && npm run build --workspace @wingdiff/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:package": "node scripts/smoke-package.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "express": "^5.2.1",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
