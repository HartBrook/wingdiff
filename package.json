{
  "name": "wingdiff",
  "version": "0.2.0",
  "private": true,
  "description": "A guided, evidence-backed tour of a pull request.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HartBrook/wingdiff.git"
  },
  "bugs": {
    "url": "https://github.com/HartBrook/wingdiff/issues"
  },
  "homepage": "https://github.com/HartBrook/wingdiff#readme",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wingdiff/server",
    "wingdiff": "npm run cli --workspace @wingdiff/server --",
    "start": "npm run start --workspace @wingdiff/server",
    "build": "npm run build --workspace @wingdiff/web && npm run build --workspace @wingdiff/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
