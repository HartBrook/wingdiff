{
  "name": "@wingdiff/server",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "bin": {
    "wingdiff": "dist/cli.js"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx src/index.ts",
    "cli": "cross-env NODE_ENV=development tsx src/cli.ts",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "express": "^5.2.1",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
